#!/bin/bash
# mmt-terminal - run a command inside whichever terminal emulator is available.
#
# Usage: mmt-terminal COMMAND [ARGS...]
#
# Terminal lookup order:
#   1. $MMT_TERMINAL, or the first non-comment line of
#      ${XDG_CONFIG_HOME:-~/.config}/multimedia-context-menu/terminal
#      (manual override, e.g. "alacritty" or "kitty")
#   2. The terminal configured in KDE (System Settings -> Default Applications)
#   3. xdg-terminal-exec
#   4. $TERMINAL
#   5. The first installed terminal from a list of well-known emulators

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/multimedia-context-menu/terminal"

# Localized error message
_lang="${LANG:-${LC_MESSAGES:-en}}"
case "${_lang%%_*}" in
    ru|be|kk) MSG_NO_TERMINAL="Не найден эмулятор терминала.\nУкажите его в файле:\n$CONFIG_FILE\n(например: konsole)" ;;
    uk)       MSG_NO_TERMINAL="Не знайдено емулятор терміналу.\nВкажіть його у файлі:\n$CONFIG_FILE\n(наприклад: konsole)" ;;
    *)        MSG_NO_TERMINAL="No terminal emulator found.\nSet one in the file:\n$CONFIG_FILE\n(for example: konsole)" ;;
esac

if [ $# -eq 0 ]; then
    echo "Usage: $(basename "$0") COMMAND [ARGS...]" >&2
    exit 2
fi

TERM_CMD=()

# try_candidate "<command line>" - accept it if its executable exists.
# The value may carry options (e.g. "konsole --profile Foo"), so split it.
try_candidate() {
    local -a parts
    read -ra parts <<< "${1:-}"
    [ "${#parts[@]}" -gt 0 ] || return 1
    command -v "${parts[0]}" > /dev/null 2>&1 || return 1
    TERM_CMD=("${parts[@]}")
}

pick_terminal() {
    local cand="${MMT_TERMINAL:-}" tool

    # 1. Manual override
    if [ -z "$cand" ] && [ -r "$CONFIG_FILE" ]; then
        cand=$(grep -v '^[[:space:]]*#' "$CONFIG_FILE" | grep -m1 '[^[:space:]]')
    fi
    try_candidate "$cand" && return 0

    # 2. KDE's own setting
    for tool in kreadconfig6 kreadconfig5; do
        if command -v "$tool" > /dev/null 2>&1; then
            cand=$("$tool" --file kdeglobals --group General --key TerminalApplication 2> /dev/null)
            try_candidate "$cand" && return 0
            break
        fi
    done

    # 3. xdg-terminal-exec (freedesktop proposal, picks the user's default)
    try_candidate "xdg-terminal-exec" && return 0

    # 4. $TERMINAL
    try_candidate "${TERMINAL:-}" && return 0

    # 5. Well-known terminals
    for cand in konsole gnome-terminal ptyxis kgx xfce4-terminal mate-terminal \
                lxterminal qterminal alacritty kitty foot wezterm tilix \
                terminator xterm urxvt st x-terminal-emulator; do
        try_candidate "$cand" && return 0
    done

    return 1
}

if ! pick_terminal; then
    echo -e "$MSG_NO_TERMINAL" >&2
    command -v kdialog > /dev/null 2>&1 && kdialog --error "$(echo -e "$MSG_NO_TERMINAL")"
    exit 1
fi

# Terminals disagree on how to say "run this command", so map the known ones.
case "$(basename "${TERM_CMD[0]}")" in
    gnome-terminal|gnome-terminal.wrapper|ptyxis)
        exec "${TERM_CMD[@]}" -- "$@" ;;
    xfce4-terminal|mate-terminal|terminator)
        exec "${TERM_CMD[@]}" -x "$@" ;;
    kitty|foot|xdg-terminal-exec)
        exec "${TERM_CMD[@]}" "$@" ;;
    wezterm)
        exec "${TERM_CMD[@]}" start -- "$@" ;;
    tilix|kgx|terminology)
        # -e takes a single command string
        exec "${TERM_CMD[@]}" -e "$(printf '%q ' "$@")" ;;
    *)
        # konsole, alacritty, xterm, urxvt, st, lxterminal, qterminal, ...
        exec "${TERM_CMD[@]}" -e "$@" ;;
esac
